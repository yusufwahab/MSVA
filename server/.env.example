# Copy to server/.env. Never commit real values.

NODE_ENV=development
PORT=4000
# Public origins (used in emails, redirects and the cross-site write check)
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# --- Database (Supabase PostgreSQL) ---------------------------------------
# DATABASE_URL: Supabase pooled connection string (Supavisor, port 6543, add ?pgbouncer=true).
# DIRECT_URL:   Supabase direct connection (port 5432); used only by `prisma migrate`.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# --- Sessions and viewing ---------------------------------------------------
SESSION_TTL_DAYS=14
# Share of the video a student must watch before the quiz unlocks
WATCH_THRESHOLD_PERCENT=80

# --- Email: one-time codes through Brevo (see docs/EMAIL.md) ---------------
# "test" stores codes in the database (development and automated tests only; refused in production)
EMAIL_ADAPTER=brevo
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=        # a sender verified in Brevo
EMAIL_FROM_NAME=MS Virtual Academy
ACTIVATION_CODE_TTL_HOURS=72
RESET_CODE_TTL_MINUTES=60

# --- ClueQuest quizzes (see docs/CLUEQUEST_INTEGRATION.md) -------------------
# "live" talks to ClueQuest's partner API. "test" is for automated tests only.
CLUEQUEST_ADAPTER=live
CLUEQUEST_API_URL=         # ClueQuest API origin, e.g. https://<cluequest-api-domain>
CLUEQUEST_API_KEY=         # printed once by ClueQuest's `npm run partner:create`
CLUEQUEST_WEBHOOK_SECRET=  # printed with the key; verifies result callbacks (HMAC-SHA256)
CLUEQUEST_BASE_URL=        # ClueQuest web origin; multiplayer room links must be on it
CLUEQUEST_AUTHORING_URL=   # page opened by "Create quiz in ClueQuest"
# MSVA owns pass mark and retakes
QUIZ_PASS_MARK_PERCENT=70
QUIZ_MAX_ATTEMPTS=0        # 0 = unlimited retakes

# --- Google sign-in (optional) ---------------------------------------------
# Redirect URI to register: <API_PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Paystack (use TEST keys only) -----------------------------------------
PAYSTACK_ADAPTER=live
PAYSTACK_SECRET_KEY=      # sk_test_...  Webhook URL: <API_PUBLIC_URL>/api/webhooks/paystack

# --- Google Sheets one-way sync (optional) ---------------------------------
# none | google
SHEETS_ADAPTER=none
GOOGLE_SHEETS_ID=
# Whole service-account JSON on one line; share the sheet with its client_email.
# Tabs expected: Registrations, Enrolments, Scores
GOOGLE_SERVICE_ACCOUNT_JSON=
# Run the Sheets job worker inside the API process (every 30s)
RUN_JOBS=1

# --- Certificates ----------------------------------------------------------
# Optional: path to the academy's Python script (reads JSON on stdin, writes PDF bytes to stdout)
CERTIFICATE_SCRIPT_PATH=
PYTHON_BIN=python

# --- Configurable links (admins can override in Settings) ------------------
COMMUNITY_URL=
WHATSAPP_URL=
WEBSITE_URL=

# Never set in production. Exposes test-only helpers (mock quiz page, email outbox).
# ENABLE_TEST_ENDPOINTS=1
