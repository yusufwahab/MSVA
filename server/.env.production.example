# Production values for the API host. Fill in every blank, never commit real values.
# Lines marked (optional) can be left blank or deleted.

NODE_ENV=production
PORT=4000
APP_URL=                       # web origin, e.g. https://portal.example.org
API_PUBLIC_URL=                # API origin, e.g. https://api.example.org

# Database (Supabase PostgreSQL)
DATABASE_URL=                  # pooled string, port 6543, ending ?pgbouncer=true
DIRECT_URL=                    # direct string, port 5432 (used only by prisma migrate)

# Sessions and viewing
SESSION_TTL_DAYS=14
WATCH_THRESHOLD_PERCENT=80

# Email: one-time codes sent through Brevo
EMAIL_ADAPTER=brevo
BREVO_API_KEY=                 # Brevo > SMTP & API > API keys
EMAIL_FROM_ADDRESS=            # a sender verified in Brevo
EMAIL_FROM_NAME=MS Virtual Academy
ACTIVATION_CODE_TTL_HOURS=72
RESET_CODE_TTL_MINUTES=60

# Quizzes: ClueQuest
CLUEQUEST_ADAPTER=live
CLUEQUEST_API_URL=             # ClueQuest API origin
CLUEQUEST_API_KEY=             # printed by `npm run partner:create` in ClueQuest
CLUEQUEST_WEBHOOK_SECRET=      # printed with the key
CLUEQUEST_BASE_URL=            # ClueQuest web origin
CLUEQUEST_AUTHORING_URL=       # page opened by "Create quiz in ClueQuest"
QUIZ_PASS_MARK_PERCENT=70
QUIZ_MAX_ATTEMPTS=0            # 0 = unlimited retakes

# Payments: Paystack (test keys until verified)
PAYSTACK_ADAPTER=live
PAYSTACK_SECRET_KEY=           # sk_test_...

# Google sign-in (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Sheets sync (optional)
SHEETS_ADAPTER=none            # none | google
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=   # whole JSON on one line
RUN_JOBS=1

# Certificates (optional)
CERTIFICATE_SCRIPT_PATH=
PYTHON_BIN=python

# Footer links (optional; admins can also set them in Settings)
COMMUNITY_URL=
WHATSAPP_URL=
WEBSITE_URL=

# Do NOT set ENABLE_TEST_ENDPOINTS or any *_ADAPTER=test in production; the API refuses to start.
