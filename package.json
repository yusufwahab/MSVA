{
  "name": "ms-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "npm --prefix server run dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && npm --prefix server run lint",
    "typecheck": "tsc --noEmit && npm --prefix server run typecheck",
    "test:api": "npm --prefix server test",
    "test:e2e": "playwright test",
    "setup:admin": "npm --prefix server run setup:admin --",
    "db:migrate": "npm --prefix server run migrate:deploy",
    "install:all": "npm install && npm --prefix server install"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}